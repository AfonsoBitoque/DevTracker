<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DevTracker.Desktop"
             x:Class="DevTracker.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- ViewLocator resolve Views a partir de ViewModels automaticamente -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
</Application>