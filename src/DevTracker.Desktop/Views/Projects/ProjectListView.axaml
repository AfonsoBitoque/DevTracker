<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevTracker.Desktop.ViewModels.Projects"
             xmlns:dto="using:DevTracker.Application.DTOs.Projects"
             x:Class="DevTracker.Desktop.Views.Projects.ProjectListView"
             x:DataType="vm:ProjectListViewModel"
             Background="#111318">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#181B22"
                BorderBrush="#2D3142" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Projects" FontSize="24" FontWeight="SemiBold" Foreground="#F5F6F8" />
                    <TextBlock Text="All workspace projects" FontSize="13" Foreground="#6B7280" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="+ New Project"
                        Command="{Binding CreateProjectCommand}"
                        IsVisible="{Binding CanCreate}"
                        Background="#2563EB" Foreground="#FFFFFF"
                        CornerRadius="6" Padding="14,8"
                        FontSize="13" FontWeight="Medium" />
            </Grid>
        </Border>

        <!-- Mensagem de erro / loading -->
        <StackPanel Grid.Row="1" Margin="24,12" Spacing="8">
            <Border Background="#3B1515" CornerRadius="6" Padding="12,8"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" />
            </Border>
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True"
                         Foreground="#2563EB" Height="2" />
        </StackPanel>

        <!-- Lista de projetos -->
        <ScrollViewer Grid.Row="2" Padding="24,0,24,24">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:ProjectSummaryDto">
                        <Border Background="#181B22"
                                BorderBrush="#2D3142" BorderThickness="1"
                                CornerRadius="8" Padding="16,14" Margin="0,0,0,8"
                                Cursor="Hand">
                            <Grid ColumnDefinitions="8,*,Auto">
                                <!-- Cor do projeto -->
                                <Border Grid.Column="0" Width="4" CornerRadius="2"
                                        Background="{Binding Color}" VerticalAlignment="Stretch" Margin="0,0,12,0" />

                                <!-- Info do projeto -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" Foreground="#F5F6F8" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock FontSize="12" Foreground="#6B7280">
                                            <Run Text="{Binding WorkItemCount}" />
                                            <Run Text=" tasks" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#6B7280">
                                            <Run Text="{Binding RepositoryCount}" />
                                            <Run Text=" repos" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding State}" FontSize="12" Foreground="#6366F1" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Open"
                                            Background="Transparent" Foreground="#2563EB"
                                            BorderBrush="#2563EB" BorderThickness="1"
                                            CornerRadius="6" Padding="10,5" FontSize="12"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).OpenProjectCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Edit"
                                            IsVisible="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).CanUpdate}"
                                            Background="Transparent" Foreground="#2563EB"
                                            BorderThickness="0" Padding="6,5" FontSize="12"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).EditProjectCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            IsVisible="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).CanDelete}"
                                            Background="Transparent" Foreground="#DC2626"
                                            BorderThickness="0" Padding="6,5" FontSize="12"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).DeleteProjectCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
