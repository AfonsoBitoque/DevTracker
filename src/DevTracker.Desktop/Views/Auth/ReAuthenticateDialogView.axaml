<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevTracker.Desktop.ViewModels.Auth"
             x:Class="DevTracker.Desktop.Views.Auth.ReAuthenticateDialogView"
             x:DataType="vm:ReAuthenticateDialogViewModel">

    <StackPanel Margin="24" Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock Text="Confirm Identity" FontSize="18" FontWeight="SemiBold" Foreground="#F5F6F8" />
            <TextBlock Text="This operation requires password confirmation."
                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" />
        </StackPanel>

        <Border Background="#3B1515" CornerRadius="6" Padding="12,8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" />
        </Border>

        <StackPanel Spacing="6">
            <TextBlock Text="Password" FontSize="13" Foreground="#A0A4B0" />
            <TextBox Text="{Binding Password}" PasswordChar="●"
                     Background="#111318" Foreground="#F5F6F8"
                     BorderBrush="#2D3142" CornerRadius="6" Padding="10,8" />
        </StackPanel>

        <Grid ColumnDefinitions="*,12,*">
            <Button Grid.Column="0" Content="Cancel"
                    Command="{Binding CancelDialogCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#1E222D" Foreground="#A0A4B0"
                    BorderBrush="#2D3142" BorderThickness="1"
                    CornerRadius="6" Padding="0,9" />

            <Button Grid.Column="2" Content="Confirm"
                    Command="{Binding ConfirmCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#2563EB" Foreground="#FFFFFF"
                    CornerRadius="6" Padding="0,9"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True"
                     Foreground="#2563EB" Height="2" />
    </StackPanel>
</UserControl>
