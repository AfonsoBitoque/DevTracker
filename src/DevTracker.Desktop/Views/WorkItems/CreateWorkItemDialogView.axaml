<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevTracker.Desktop.ViewModels.WorkItems"
             x:Class="DevTracker.Desktop.Views.WorkItems.CreateWorkItemDialogView"
             x:DataType="vm:CreateWorkItemDialogViewModel">

    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="New Work Item" FontSize="18" FontWeight="SemiBold" Foreground="#F5F6F8" />

        <Border Background="#3B1515" CornerRadius="6" Padding="12,8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- Titulo -->
        <StackPanel Spacing="6">
            <TextBlock Text="Title *" FontSize="13" Foreground="#A0A4B0" />
            <TextBox Text="{Binding Title}" PlaceholderText="Describe what needs to be done..."
                     Background="#111318" Foreground="#F5F6F8"
                     BorderBrush="#2D3142" CornerRadius="6" Padding="10,8" />
        </StackPanel>

        <!-- Descricao -->
        <StackPanel Spacing="6">
            <TextBlock Text="Description (optional)" FontSize="13" Foreground="#A0A4B0" />
            <TextBox Text="{Binding Description}" PlaceholderText="Detail the context, acceptance criteria..."
                     Background="#111318" Foreground="#F5F6F8"
                     BorderBrush="#2D3142" CornerRadius="6" Padding="10,8"
                     AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Type e Priority -->
        <Grid ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Type" FontSize="13" Foreground="#A0A4B0" />
                <ComboBox SelectedItem="{Binding Type}"
                          ItemsSource="{Binding AvailableTypes}"
                          Background="#111318" Foreground="#F5F6F8"
                          BorderBrush="#2D3142" CornerRadius="6"
                          HorizontalAlignment="Stretch" Padding="10,8" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Priority" FontSize="13" Foreground="#A0A4B0" />
                <ComboBox SelectedItem="{Binding Priority}"
                          ItemsSource="{Binding AvailablePriorities}"
                          Background="#111318" Foreground="#F5F6F8"
                          BorderBrush="#2D3142" CornerRadius="6"
                          HorizontalAlignment="Stretch" Padding="10,8" />
            </StackPanel>
        </Grid>

        <!-- Difficulty e Estimated Time -->
        <Grid ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Difficulty" FontSize="13" Foreground="#A0A4B0" />
                <ComboBox SelectedItem="{Binding Difficulty}"
                          ItemsSource="{Binding AvailableDifficulties}"
                          Background="#111318" Foreground="#F5F6F8"
                          BorderBrush="#2D3142" CornerRadius="6"
                          HorizontalAlignment="Stretch" Padding="10,8" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Estimated Time" FontSize="13" Foreground="#A0A4B0" />
                <ComboBox SelectedItem="{Binding EstimatedTime}"
                          ItemsSource="{Binding AvailableEstimatedTimes}"
                          Background="#111318" Foreground="#F5F6F8"
                          BorderBrush="#2D3142" CornerRadius="6"
                          HorizontalAlignment="Stretch" Padding="10,8" />
            </StackPanel>
        </Grid>

        <!-- Estimated Prompts -->
        <StackPanel Spacing="6">
            <TextBlock Text="Estimated Prompts" FontSize="13" Foreground="#A0A4B0" />
            <TextBox Text="{Binding EstimatedPrompts, Mode=TwoWay}"
                     PlaceholderText="0"
                     Background="#111318" Foreground="#F5F6F8"
                     BorderBrush="#2D3142" CornerRadius="6" Padding="10,8" />
        </StackPanel>

        <!-- Botoes -->
        <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
            <Button Grid.Column="0" Content="Cancel"
                    Command="{Binding CancelDialogCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#1E222D" Foreground="#A0A4B0"
                    BorderBrush="#2D3142" BorderThickness="1"
                    CornerRadius="6" Padding="0,9" />
            <Button Grid.Column="2" Content="Create"
                    Command="{Binding ConfirmCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#2563EB" Foreground="#FFFFFF"
                    CornerRadius="6" Padding="0,9" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True"
                     Foreground="#2563EB" Height="2" />
    </StackPanel>
</UserControl>
