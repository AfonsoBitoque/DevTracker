<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevTracker.Desktop.ViewModels.WorkItems"
             x:Class="DevTracker.Desktop.Views.WorkItems.PauseTaskDialogView"
             x:DataType="vm:PauseTaskDialogViewModel"
             Width="520" Height="320">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Pause Task" FontSize="18" FontWeight="SemiBold" Foreground="#F5F6F8" />
            <TextBlock Text="Leave a note about your progress for when you resume."
                       FontSize="13" Foreground="#A0A4B0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Nota -->
        <Border Grid.Row="1" Background="#181B22" BorderBrush="#2D3142" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <TextBox Text="{Binding Note, Mode=TwoWay}"
                     PlaceholderText="What remains to be done? Where did you stop with the AI? Leave a note for your future self..."
                     AcceptsReturn="True"
                     Background="Transparent" Foreground="#F5F6F8"
                     BorderThickness="0"
                     FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- Botões -->
        <Grid Grid.Row="2" ColumnDefinitions="*,12,*" Margin="0,16,0,0">
            <Button Grid.Column="0" Content="Cancel"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#1E222D" Foreground="#A0A4B0"
                    BorderBrush="#2D3142" BorderThickness="1"
                    CornerRadius="6" Padding="0,10" />

            <Button Grid.Column="2" Content="Save Note"
                    Command="{Binding ConfirmCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#2563EB" Foreground="#FFFFFF"
                    CornerRadius="6" Padding="0,10" />
        </Grid>
    </Grid>
</UserControl>
