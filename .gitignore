## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
.vscode/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Avalonia
.avalonia/

# macOS
.DS_Store

# JetBrains Rider
.idea/
*.sln.iml

# Test results
TestResults/

# Database files
*.db
*.db-journal
*.db-shm
*.db-wal

# Config with secrets (if generated)
config.json

# ASP.NET / .NET AppSettings with secrets
appsettings.json
appsettings.Development.json
appsettings.Local.json
local.settings.json

# Environment variables & secrets
.env
*.env
.env.local
.env.*.local

# IDE / OS
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup
*.orig

# Keys & certificates
*.pfx
*.p12
*.pem
*.key
certs/
keys/
